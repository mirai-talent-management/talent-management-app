# Supabase project settings (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only key used for admin operations (e.g. issuing invites). Never expose to the client.
SUPABASE_SECRET_KEY=

# Resend (transactional email)
RESEND_API_KEY=

# Base URL used in generated links (magic links, invite emails)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
